# =============================================================================
# WMT Origin Market — Web App Environment Variables
# Copy to .env.local and fill in values before running.
#
# SECURITY BOUNDARY — this file is for apps/web (Next.js) ONLY.
#
#   ✅ NEXT_PUBLIC_* vars are safe — they are intentionally exposed to the browser.
#   ✅ Non-NEXT_PUBLIC_ vars here are used ONLY in Next.js API routes (server-side).
#
#   ❌ NEVER put these here:
#        SUPABASE_SERVICE_KEY  → bypasses RLS; belongs in services/auth-api
#        SUPABASE_JWT_SECRET   → can forge tokens; belongs in services/auth-api
#        STRIPE_SECRET_KEY     → belongs in services/order-api
#        OPENAI_API_KEY        → belongs in services/ml-pipeline
#        RESEND_API_KEY        → belongs in services/auth-api
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE — public (browser-safe) check in supabase dashboard to get anon key
# Copy from `supabase start` output (local) or Supabase dashboard (hosted)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here


# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Origin Market"
NEXT_PUBLIC_CDN_URL=

# -----------------------------------------------------------------------------
# PAYMENTS — Stripe publishable key only (browser-safe)
# The secret key lives in services/order-api/.env
# -----------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# -----------------------------------------------------------------------------
# JWT signing secret — used only in Next.js API routes (never sent to browser)
# Keep this value secret; do NOT prefix with NEXT_PUBLIC_
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-min-32-chars-random-string

# -----------------------------------------------------------------------------
# FEATURE FLAGS  (set to "true" / "false")
# -----------------------------------------------------------------------------
FEATURE_FLAG_ORIGIN_VERIFY=true
FEATURE_FLAG_RAG=false
FEATURE_FLAG_CULTURAL_CONTEXT=false
FEATURE_FLAG_MULTI_CURRENCY=false
FEATURE_FLAG_MULTI_LANGUAGE=false
FEATURE_FLAG_SELLER_KYC=false
FEATURE_FLAG_LLM_ROUTER=false


# -----------------------------------------------------------------------------
# EVAL / CI
# -----------------------------------------------------------------------------
# Set to "1" to use real GPT-4o in eval scripts (costs money)
USE_REAL_MODEL=0
